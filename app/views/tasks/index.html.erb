<!-- app/views/tasks/index.html.erb -->
<!-- Login Page: JohnJad Web -->
<!-- ทุกอย่าง (HTML/CSS/JS) รวมอยู่ในไฟล์นี้ไฟล์เดียว ตามที่ร้องขอ -->

<style>
  .login-page {
    --bg: #f4f6fb;
    --card-bg: #ffffff;
    --text-main: #1f2937;
    --text-sub: #9ca3af;
    --text-label: #374151;
    --text-muted: #6b7280;
    --input-bg: #f9fafb;
    --input-border: #e5e7eb;
    --shadow: rgba(17, 24, 39, 0.08);
    --accent-1: #6366f1;
    --accent-2: #ec4899;
    --accent-3: #22d3ee;
    --danger: #ef4444;

    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: var(--bg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans Thai", Arial, sans-serif;
    padding: 24px;
    transition: background 0.3s ease;
  }

  .login-page[data-theme="dark"] {
    --bg: #0f1220;
    --card-bg: #171a2b;
    --text-main: #f3f4f6;
    --text-sub: #9ca3af;
    --text-label: #e5e7eb;
    --text-muted: #a1a1aa;
    --input-bg: #1f2337;
    --input-border: #2c3049;
    --shadow: rgba(0, 0, 0, 0.5);
    --accent-1: #818cf8;
    --accent-2: #f472b6;
    --accent-3: #67e8f9;
  }

  .login-page * {
    box-sizing: border-box;
  }

  /* soft gradient blobs in the background for a bit of color/personality */
  .bg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
    z-index: 0;
    pointer-events: none;
  }

  .bg-blob.blob-1 {
    width: 320px;
    height: 320px;
    top: -80px;
    left: -80px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-3));
  }

  .bg-blob.blob-2 {
    width: 300px;
    height: 300px;
    bottom: -100px;
    right: -80px;
    background: linear-gradient(135deg, var(--accent-2), var(--accent-1));
  }

  .theme-toggle {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--card-bg);
    border: 1px solid var(--input-border);
    border-radius: 999px;
    padding: 6px 14px 6px 6px;
    cursor: pointer;
    box-shadow: 0 4px 14px var(--shadow);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-label);
    user-select: none;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .theme-toggle .icon-badge {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
  }

  .login-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 380px;
    background: var(--card-bg);
    border-radius: 18px;
    box-shadow: 0 10px 30px var(--shadow);
    padding: 40px 32px;
    border: 1px solid transparent;
    background-clip: padding-box;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .login-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
    padding: 1.5px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2), var(--accent-3));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    pointer-events: none;
  }

  .login-brand {
    text-align: center;
    margin-bottom: 28px;
  }

  .login-brand h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .dog-sticker {
    display: inline-flex;
    font-size: 22px;
    line-height: 1;
    transform: rotate(-8deg);
    animation: wag 2.4s ease-in-out infinite;
  }

  @keyframes wag {
    0%, 100% { transform: rotate(-8deg); }
    50% { transform: rotate(8deg); }
  }

  .login-brand p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--text-sub);
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-label);
    margin-bottom: 6px;
  }

  .form-group input[type="email"],
  .form-group input[type="password"] {
    width: 100%;
    padding: 12px 14px;
    font-size: 14px;
    border: 1px solid var(--input-border);
    border-radius: 10px;
    background: var(--input-bg);
    color: var(--text-main);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .form-group input[type="email"]:focus,
  .form-group input[type="password"]:focus {
    border-color: var(--accent-1);
    background: var(--card-bg);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18);
  }

  .form-group input.is-invalid {
    border-color: var(--danger);
  }

  .form-error {
    display: none;
    color: var(--danger);
    font-size: 12px;
    margin-top: 6px;
  }

  .form-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    font-size: 13px;
  }

  .remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    cursor: pointer;
    user-select: none;
  }

  .remember-me input {
    width: 15px;
    height: 15px;
    accent-color: var(--accent-1);
    cursor: pointer;
  }

  .forgot-link {
    color: var(--accent-1);
    text-decoration: none;
    font-weight: 600;
  }

  .forgot-link:hover {
    text-decoration: underline;
  }

  .btn-login {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
    background-size: 160% 160%;
    background-position: 0% 50%;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
    transition: background-position 0.35s ease, transform 0.05s ease, box-shadow 0.2s ease;
  }

  .btn-login:hover {
    background-position: 100% 50%;
    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.45);
  }

  .btn-login:active {
    transform: scale(0.99);
  }

  .signup-text {
    text-align: center;
    margin-top: 22px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .signup-text a {
    color: var(--accent-1);
    font-weight: 700;
    text-decoration: none;
  }

  .signup-text a:hover {
    text-decoration: underline;
  }

  @media (max-width: 420px) {
    .login-card {
      padding: 32px 22px;
      border-radius: 14px;
    }

    .theme-toggle {
      top: 14px;
      right: 14px;
    }
  }
</style>

<div class="login-page" id="login-page" data-theme="light">
  <div class="bg-blob blob-1"></div>
  <div class="bg-blob blob-2"></div>

  <button type="button" class="theme-toggle" id="theme-toggle" aria-label="สลับโหมดมืด/สว่าง">
    <span class="icon-badge" id="theme-icon">🌙</span>
    <span id="theme-label">Dark mode</span>
  </button>

  <div class="login-card">
    <div class="login-brand">
      <h1>JohnJad Web <span class="dog-sticker" role="img" aria-label="dog"></span></h1>
      <p>Sign in</p>
    </div>

    <%= form_with url: login_path, method: :post, local: true, id: "login-form" do %>
      <div class="form-group">
        <label for="login-email">Email</label>
        <input type="email" id="login-email" name="email" placeholder="you@example.com" autocomplete="email" required>
        <span class="form-error" id="email-error">Please enter a valid email address.</span>
      </div>

      <div class="form-group">
        <label for="login-password">Password</label>
        <input type="password" id="login-password" name="password" placeholder="••••••••" autocomplete="current-password" required>
        <span class="form-error" id="password-error">Password is required.</span>
      </div>

      <div class="form-row">
        <label class="remember-me">
          <input type="checkbox" name="remember_me" id="remember-me">
          Remember me
        </label>
        <a href="#" class="forgot-link">Forgot password?</a>
      </div>

      <button type="submit" class="btn-login">Login</button>
    <% end %>

    <p class="signup-text">Don't have an account? <a href="#">Sign up</a></p>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById("login-form");
    var emailInput = document.getElementById("login-email");
    var passwordInput = document.getElementById("login-password");
    var emailError = document.getElementById("email-error");
    var passwordError = document.getElementById("password-error");

    function isValidEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
    }

    function toggleField(input, errorEl, valid) {
      if (valid) {
        input.classList.remove("is-invalid");
        errorEl.style.display = "none";
      } else {
        input.classList.add("is-invalid");
        errorEl.style.display = "block";
      }
    }

    if (form) {
      form.addEventListener("submit", function (e) {
        var emailValid = isValidEmail(emailInput.value.trim());
        var passwordValid = passwordInput.value.trim().length > 0;

        toggleField(emailInput, emailError, emailValid);
        toggleField(passwordInput, passwordError, passwordValid);

        if (!emailValid || !passwordValid) {
          e.preventDefault();
        }
      });

      [emailInput, passwordInput].forEach(function (input) {
        input.addEventListener("input", function () {
          input.classList.remove("is-invalid");
          (input === emailInput ? emailError : passwordError).style.display = "none";
        });
      });
    }

    // --- Dark / Light mode toggle ---
    var page = document.getElementById("login-page");
    var toggleBtn = document.getElementById("theme-toggle");
    var themeIcon = document.getElementById("theme-icon");
    var themeLabel = document.getElementById("theme-label");
    var STORAGE_KEY = "johnjad-theme";

    function applyTheme(theme) {
      page.setAttribute("data-theme", theme);
      if (theme === "dark") {
        themeIcon.textContent = "☀️";
        themeLabel.textContent = "Light mode";
      } else {
        themeIcon.textContent = "🌙";
        themeLabel.textContent = "Dark mode";
      }
    }

    function getPreferredTheme() {
      var saved = null;
      try {
        saved = localStorage.getItem(STORAGE_KEY);
      } catch (err) {
        saved = null;
      }
      if (saved === "dark" || saved === "light") return saved;
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    applyTheme(getPreferredTheme());

    toggleBtn.addEventListener("click", function () {
      var next = page.getAttribute("data-theme") === "dark" ? "light" : "dark";
      applyTheme(next);
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch (err) {
        /* localStorage unavailable, ignore */
      }
    });
  })();
</script>
